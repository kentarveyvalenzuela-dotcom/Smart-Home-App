# Copy to backend/.env for local API development. Keep real values private.
DATABASE_URL=postgresql://postgres:Passw0rd23@localhost:5432/smart_home_db
SECRET_KEY=replace-with-a-long-random-secret
DEVICE_INGEST_API_KEY=replace-with-a-long-random-device-ingest-key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Use the Web OAuth client ID registered for this Google Cloud project.
GOOGLE_CLIENT_ID=1064102549321-qo3r05pacah64385hhac41m049h180uj.apps.googleusercontent.com

# SMTP submission settings. Gmail requires a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-email@gmail.com

# Comma-separated Flutter Web origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Backend MQTT publisher/listener; use the same broker account as the ESP32.
MQTT_BROKER=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-new-mqtt-password
