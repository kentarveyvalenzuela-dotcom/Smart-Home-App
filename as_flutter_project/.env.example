# Copy these values into as_flutter_project/.env. Never commit real credentials.
DATABASE_URL=postgresql://postgres:Passw0rd23@localhost:5432/smart_home_db
GOOGLE_CLIENT_ID=1064102549321-qo3r05pacah64385hhac41m049h180uj.apps.googleusercontent.com
# SMTP settings for password reset and verification emails.
# For Gmail, use smtp.gmail.com:587 and an app password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=your-email@gmail.com

# MQTT publisher used by the authenticated backend device-control API.
# These are placeholders. Rotate exposed credentials at the broker, then put
# the new values in the untracked .env file; never commit real credentials.
MQTT_BROKER=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-new-mqtt-password
MQTT_USE_TLS=true

# Must match DEVICE_INGEST_API_KEY in scripts/secrets.h on the ESP32.
DEVICE_INGEST_API_KEY=your-device-ingest-api-key
ENERGY_DEVICE_ID=admin

# Optional server-side Firebase Admin service account JSON (keep only in local/deployment secrets).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Comma-separated Flutter Web origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
