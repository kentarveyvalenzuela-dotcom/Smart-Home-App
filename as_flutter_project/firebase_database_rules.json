{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",

        "sensors": {
          ".read": true,
          ".write": true
        },
        "devices": {
          ".read": true,
          ".write": true
        },
        "energy_data": {
          ".read": true,
          ".write": true,
          ".indexOn": ["timestamp"]
        },
        "alerts": {
          ".read": true,
          ".write": true,
          ".indexOn": ["timestamp"]
        },
        "notifications": {
          ".read": true,
          ".write": true,
          ".indexOn": ["timestamp"]
        }
      }
    },
    "devices": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "sensor_data": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}

