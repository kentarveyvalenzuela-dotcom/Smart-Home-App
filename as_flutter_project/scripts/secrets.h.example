# Copy to secrets.h and replace placeholders locally. secrets.h is git-ignored.
# Revoke/rotate any MQTT credential that was ever committed or shared, then use
# only the newly generated credential here. Never put secrets in a .ino file.
# Rotate any credentials that were previously committed in source files.
